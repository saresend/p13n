{
  "openapi": "3.1.0",
  "info": {
    "title": "dsys",
    "version": "0.1.0",
    "description": "System-of-record API for actions taken across applications, plus task management with on-disk description and progress-log files."
  },
  "servers": [{ "url": "http://127.0.0.1:8081" }],
  "security": [],
  "tags": [
    { "name": "health" },
    { "name": "actions", "description": "Actions taken across applications." },
    { "name": "tasks", "description": "Task rows (kyogre-compatible shape)." },
    { "name": "task files", "description": "A task's description.md and progress_log.md." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "operationId": "health",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Server is up.",
            "content": { "text/plain": { "schema": { "type": "string", "const": "ok" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["health"],
        "operationId": "openapi",
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/actions": {
      "post": {
        "tags": ["actions"],
        "operationId": "createAction",
        "summary": "Record an action",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAction" } } }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Action" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "get": {
        "tags": ["actions"],
        "operationId": "listActions",
        "summary": "List actions, newest first",
        "parameters": [
          { "name": "source_application", "in": "query", "schema": { "type": "string" } },
          { "name": "action_name", "in": "query", "schema": { "type": "string" } },
          {
            "name": "since",
            "in": "query",
            "description": "Inclusive lower bound, Unix epoch milliseconds.",
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "until",
            "in": "query",
            "description": "Exclusive upper bound, Unix epoch milliseconds.",
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Clamped to 1..1000.",
            "schema": { "type": "integer", "format": "int64", "default": 100, "minimum": 1, "maximum": 1000 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "format": "int64", "default": 0, "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching actions, ordered by timestamp then id, descending.",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Action" } } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/actions/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["actions"],
        "operationId": "getAction",
        "summary": "Get one action",
        "responses": {
          "200": {
            "description": "The action.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Action" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "tags": ["actions"],
        "operationId": "updateAction",
        "summary": "Partially update an action",
        "description": "At least one field must be given.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAction" } } }
        },
        "responses": {
          "200": {
            "description": "The updated action.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Action" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["actions"],
        "operationId": "deleteAction",
        "summary": "Delete an action",
        "responses": {
          "204": { "description": "Deleted." },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/tasks": {
      "post": {
        "tags": ["tasks"],
        "operationId": "createTask",
        "summary": "Create a task",
        "description": "Creates `<tasks_dir>/<title>/` (suffixed `-2`, `-3`, ... on collision) with description.md and progress_log.md, and inserts a row with status `Available`.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTask" } } }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "get": {
        "tags": ["tasks"],
        "operationId": "listTasks",
        "summary": "List tasks by id",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/TaskStatus" } },
          { "name": "model", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Matching tasks, ordered by id ascending.",
            "content": {
              "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["tasks"],
        "operationId": "getTask",
        "summary": "Get one task",
        "responses": {
          "200": {
            "description": "The task.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "tags": ["tasks"],
        "operationId": "updateTask",
        "summary": "Partially update a task",
        "description": "At least one field must be given. Setting `status` to anything other than `In-Progress` resets `taken_by_pid` and `taken_by_start` to 0 unless they are given. With `expected_status`, the update applies only if the task currently has that status, which lets a worker claim an `Available` task atomically.",
        "parameters": [
          {
            "name": "expected_status",
            "in": "query",
            "description": "Apply the update only if the task's current status matches; otherwise 409.",
            "schema": { "$ref": "#/components/schemas/TaskStatus" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTask" } } }
        },
        "responses": {
          "200": {
            "description": "The updated task.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["tasks"],
        "operationId": "deleteTask",
        "summary": "Delete a task",
        "parameters": [
          {
            "name": "keep_files",
            "in": "query",
            "description": "Keep the task's folder and files on disk.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "204": { "description": "Deleted." },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/tasks/{id}/description": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["task files"],
        "operationId": "readTaskDescription",
        "summary": "Read description.md",
        "responses": {
          "200": { "$ref": "#/components/responses/Markdown" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["task files"],
        "operationId": "writeTaskDescription",
        "summary": "Replace description.md",
        "requestBody": { "$ref": "#/components/requestBodies/Text" },
        "responses": {
          "204": { "description": "Written." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/tasks/{id}/log": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["task files"],
        "operationId": "readTaskLog",
        "summary": "Read progress_log.md",
        "responses": {
          "200": { "$ref": "#/components/responses/Markdown" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["task files"],
        "operationId": "appendTaskLog",
        "summary": "Append a dated entry to progress_log.md",
        "description": "The body must not be empty or whitespace only.",
        "requestBody": { "$ref": "#/components/requestBodies/Text" },
        "responses": {
          "204": { "description": "Appended." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["task files"],
        "operationId": "writeTaskLog",
        "summary": "Replace progress_log.md",
        "requestBody": { "$ref": "#/components/requestBodies/Text" },
        "responses": {
          "204": { "description": "Written." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
    },
    "requestBodies": {
      "Text": {
        "required": true,
        "description": "UTF-8 text, sent as the raw body (any content type).",
        "content": { "text/markdown": { "schema": { "type": "string" } }, "text/plain": { "schema": { "type": "string" } } }
      }
    },
    "responses": {
      "Markdown": {
        "description": "File contents.",
        "content": { "text/markdown": { "schema": { "type": "string" } } }
      },
      "BadRequest": {
        "description": "Invalid input.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "No such resource.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "The task's status did not match `expected_status`.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServerError": {
        "description": "Database, pool or file storage error.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "Action": {
        "type": "object",
        "required": ["id", "source_application", "action_name", "payload", "timestamp"],
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "source_application": { "type": "string" },
          "action_name": { "type": "string" },
          "payload": { "description": "Arbitrary JSON parameters for the action." },
          "timestamp": { "type": "integer", "format": "int64", "description": "Unix epoch milliseconds." }
        }
      },
      "CreateAction": {
        "type": "object",
        "required": ["source_application", "action_name"],
        "properties": {
          "source_application": { "type": "string", "minLength": 1 },
          "action_name": { "type": "string", "minLength": 1 },
          "payload": { "description": "Arbitrary JSON. Defaults to null." },
          "timestamp": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "Unix epoch milliseconds. Defaults to now."
          }
        }
      },
      "UpdateAction": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "source_application": { "type": "string", "minLength": 1 },
          "action_name": { "type": "string", "minLength": 1 },
          "payload": { "description": "Arbitrary JSON." },
          "timestamp": { "type": "integer", "format": "int64" }
        }
      },
      "TaskStatus": { "type": "string", "enum": ["Available", "In-Progress", "Complete"] },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "task_description_path",
          "progress_log_path",
          "model",
          "taken_by_pid",
          "taken_by_start"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "title": { "type": "string" },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "task_description_path": { "type": "string", "description": "Absolute path to description.md." },
          "progress_log_path": { "type": "string", "description": "Absolute path to progress_log.md." },
          "model": { "type": "string" },
          "taken_by_pid": { "type": "integer", "format": "int32", "description": "PID of the claiming worker; 0 when unclaimed." },
          "taken_by_start": { "type": "integer", "format": "int32", "description": "Start time of the claiming worker; 0 when unclaimed." }
        }
      },
      "CreateTask": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "default": "", "description": "Body of description.md, under a `# <title>` heading." },
          "model": { "type": "string", "default": "" }
        }
      },
      "UpdateTask": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/components/schemas/TaskStatus" },
          "model": { "type": "string" },
          "taken_by_pid": { "type": "integer", "format": "int32" },
          "taken_by_start": { "type": "integer", "format": "int32" }
        }
      }
    }
  }
}
