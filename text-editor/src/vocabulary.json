{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "text-editor actions",
  "description": "Vocabulary for p13n/text-editor: one object per action, { action_name, payload }.",
  "type": "object",
  "required": ["action_name", "payload"],
  "oneOf": [
    {
      "properties": {
        "action_name": { "enum": ["create", "select", "delete"] },
        "payload": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "action_name": { "enum": ["write_text", "save"] },
        "payload": {
          "type": "object",
          "required": ["id", "text"],
          "properties": { "id": { "type": "string" }, "text": { "type": "string" } },
          "additionalProperties": false
        }
      }
    }
  ]
}
