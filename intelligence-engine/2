#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .service(create_user)
            .service(create_user_session)
            .service(list_user_sessions)
    })
    .bind(("127.0.0.1", 8080))?
